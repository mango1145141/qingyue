<Window x:Class="EpubKindleFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:EpubKindleFix"
        Title="轻阅" Icon="Assets/KindleIcon.png"
        Width="1120" Height="900" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" AllowDrop="True" WindowStyle="None" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="86" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Canvas}" BorderBrush="#D8D8DC" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="51"/></Grid.RowDefinitions>
            <Grid Margin="36,12,20,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="43" Height="43" CornerRadius="13" Background="#57799D" Margin="0,0,12,0">
                        <Viewbox Width="26" Height="24">
                            <Path Data="M 20,6 C 12,1 5,2 0,4 L 0,30 C 7,28 13,29 20,33 C 27,29 33,28 40,30 L 40,4 C 35,2 28,1 20,6 M 20,6 L 20,33"
                                  Stroke="#F7F5ED" StrokeThickness="2.4" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="轻阅" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="F O R   K I N D L E" FontFamily="Segoe UI" FontSize="8" Foreground="{DynamicResource Muted}" Margin="1,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LibraryButton" Content="登录 Z-Library" Style="{StaticResource QuietButton}" Click="LibraryButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ComicButton" Content="登录 koz.moe" Style="{StaticResource QuietButton}" Click="ComicButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="AmazonButton" Content="连接亚马逊" Style="{StaticResource QuietButton}" Click="AmazonButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SyncButton" Content="设备同步" Style="{StaticResource QuietButton}" Click="SyncButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource QuietButton}" Click="SettingsButton_Click"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="0,0,12,0"/>
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最小化" ToolTip="最小化" Click="Minimize_Click"/>
                    <Button Content="&#xE922;" Style="{StaticResource CaptionButton}" AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原" Click="Maximize_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" AutomationProperties.Name="关闭" ToolTip="关闭" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0" Padding="0,0,0,24" ScrollChanged="MainScroll_ScrollChanged" PreviewMouseWheel="MainScroll_PreviewMouseWheel" PreviewKeyDown="MainScroll_PreviewKeyDown">
                <StackPanel Width="760" HorizontalAlignment="Center">
                    <Grid x:Name="DailyQuoteCard" Margin="0,13,0,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="#9CB2C7" CornerRadius="2" Margin="0,4,0,5"/>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <TextBlock Text="每 日 · 一 句" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DailyQuoteText" FontSize="25" FontWeight="Medium" Foreground="{DynamicResource Ink}" LineHeight="38" TextWrapping="Wrap" Text="学而时习之，不亦说乎？"/>
                            <TextBlock x:Name="DailyQuoteAttribution" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,11,0,0" Text="孔子 ·《论语·学而》"/>
                        </StackPanel>
                        <Button x:Name="DailyQuoteSourceButton" Grid.Column="2" Content="读原文 ↗" Style="{StaticResource QuietButton}" FontSize="11.5" Padding="12,8" VerticalAlignment="Bottom" Margin="18,0,0,-3" Click="DailyQuoteSource_Click"/>
                    </Grid>
            <StackPanel Width="760" HorizontalAlignment="Center" Margin="0,0,0,23">
                <StackPanel x:Name="LibrarySearchCard" Visibility="Collapsed">
                    <Grid Margin="2,0,2,13">
                        <TextBlock Text="下一本，想读什么？" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="Z-LIBRARY 书库" FontSize="11" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                    <Border Style="{StaticResource CardShadowLayer}" CornerRadius="16"/>
                    <Border Style="{StaticResource Card}" CornerRadius="16" Padding="17,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="0,0,15,0">
                                <TextBox x:Name="LibrarySearchBox" ToolTip="输入书名、作者或 ISBN" AutomationProperties.Name="书籍搜索"
                                         KeyDown="LibrarySearchBox_KeyDown" BorderThickness="0" Height="56" Padding="0,8" FontSize="18"
                                         VerticalContentAlignment="Center" TextWrapping="NoWrap" AcceptsReturn="False"
                                         HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" MaxLength="300"/>
                                <TextBlock Text="输入书名、作者或 ISBN" FontSize="16" Foreground="{DynamicResource Subtle}" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="LibrarySearchButton" Grid.Column="2" Content="搜索书籍  ↗" FontSize="15" MinWidth="142" Height="50" Padding="22,10" VerticalAlignment="Center" Click="LibrarySearch_Click"/>
                        </Grid>
                    </Border>
                    </Grid>
                    <TextBlock x:Name="LibraryConnectionText" Text="搜索书名、作者或 ISBN，选择 EPUB 后自动修复并发送。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,11,2,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="LibraryNotice" Visibility="Collapsed" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"/>
                <StackPanel x:Name="ComicSearchCard" Margin="0,22,0,0">
                    <Grid Margin="2,0,2,13">
                        <TextBlock Text="下一部，想看什么？" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="KOZ.MOE 漫画" FontSize="11" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Border Style="{StaticResource CardShadowLayer}" CornerRadius="16"/>
                        <Border Style="{StaticResource Card}" CornerRadius="16" Padding="17,7">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="0,0,15,0">
                                    <TextBox x:Name="ComicSearchBox" ToolTip="输入漫画名或作者" AutomationProperties.Name="漫画搜索"
                                             KeyDown="ComicSearchBox_KeyDown" BorderThickness="0" Height="56" Padding="0,8" FontSize="18"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap" AcceptsReturn="False"
                                             HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" MaxLength="100"/>
                                    <TextBlock Text="输入漫画名或作者" FontSize="16" Foreground="{DynamicResource Subtle}" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ComicSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="ComicSearchButton" Grid.Column="2" Content="搜索漫画  ↗" FontSize="15" MinWidth="142" Height="50" Padding="22,10" VerticalAlignment="Center" Click="ComicSearch_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ComicConnectionText" Text="在网站选择漫画和卷数，可直接推送到 Kindle；下载 EPUB 后也可交给轻阅修复。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,11,2,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ComicNotice" Visibility="Collapsed" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"/>
                </StackPanel>
            </StackPanel>
                    <StackPanel x:Name="HeroIntro" Visibility="Collapsed" Margin="0,0,0,23">
                        <StackPanel x:Name="HeroEyebrow" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,13">
                            <Ellipse Width="5" Height="5" Fill="#34C759" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="为 你 的 下 一 本 好 书" FontSize="10" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroTitle" Text="把时间，留给阅读。" Visibility="Collapsed" FontSize="26" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock x:Name="HeroSubtitle" Text="选一本书，剩下的交给轻阅。" FontSize="12" Foreground="{DynamicResource Muted}" TextAlignment="Left"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,13">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="我的书架  ↗" Style="{StaticResource QuietButton}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Accent}" Padding="0,2" Click="Bookshelf_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnectionDot" Width="5" Height="5" Fill="#C7C7CC" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="ConnectionBadge" Text="邮箱待连接" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="18" Background="{DynamicResource Line}" Margin="16,0"/>
                                    <Button x:Name="QueueButton" Content="发送队列" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="14,8" Click="Queue_Click" ToolTip="查看发送进度、暂停与重试"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Height="2" Width="86" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock x:Name="SettingsNotice" Visibility="Collapsed" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0,8,14"/>

                    <Grid>
                    <Border Style="{StaticResource CardShadowLayer}"/>
                    <Border x:Name="DropZone" Style="{StaticResource Card}" MinHeight="126" Padding="22,20"
                            AllowDrop="True" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid x:Name="DropIllustration" Width="62" Height="74" Margin="0,0,22,0" VerticalAlignment="Center">
                                <Border Background="#E9E9EB" CornerRadius="5,8,8,5" Margin="5,5,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform>
                                </Border>
                                <Border Background="#8BA6BF" CornerRadius="4,8,8,4" Margin="0,0,6,5" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
                                    <Viewbox Width="31" Height="28">
                                        <Path Data="M 20,6 C 12,1 5,2 0,4 L 0,30 C 7,28 13,29 20,33 C 27,29 33,28 40,30 L 40,4 C 35,2 28,1 20,6 M 20,6 L 20,33" Stroke="#FFFFFF" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="DropHeading" Text="让好书，轻松抵达。" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                <TextBlock x:Name="DropSubtitle" Text="把 EPUB 拖到这里，或从电脑中选择" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
                                <TextBlock x:Name="DropHint" Text="可一次选入多本 · 原书保持完整" FontSize="10.5" Foreground="{DynamicResource Subtle}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="ChooseButton" Content="＋  选择书籍" MinWidth="144" Click="ChooseButton_Click"/>
                                <Button x:Name="StartRepairButton" Content="检查并修复" Visibility="Collapsed" Margin="0,8,0,0" Click="StartRepair_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </Grid>

                    <Border x:Name="ProgressCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="23,21" Margin="0,15,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="39" Height="45" CornerRadius="8" Background="{DynamicResource SoftPanel}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="#7591AB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,15,0">
                                <TextBlock x:Name="BookName" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StatusText" Text="正在准备…" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,14,0,0" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="#E9E9EA" BorderThickness="0"/>
                                <WrapPanel x:Name="WebUploadActions" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Button x:Name="InspectUploadButton" Content="查看发送" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="13,8" Click="InspectUpload_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DeferUploadButton" Content="稍后发送" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,8" Click="DeferUpload_Click"/>
                                </WrapPanel>
                            </StackPanel>
                            <Border Grid.Column="2" Width="29" Height="29" CornerRadius="15" Background="#EAF8EE">
                                <TextBlock x:Name="StatusIcon" FontSize="17" Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="ReportCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="25,23" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,17"><TextBlock Text="检查修复已完成" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="原文件已保留" FontSize="10" Foreground="{DynamicResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                            <Border BorderBrush="#E9E9EC" BorderThickness="0,1" Padding="0,17">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="ImagesFoundText" Text="0" FontFamily="Segoe UI" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextAlignment="Center"/><TextBlock Text="检查图片" FontSize="10" Foreground="{DynamicResource Subtle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                    <Border Grid.Column="1" BorderBrush="#E9E9EC" BorderThickness="1,0"><StackPanel><TextBlock x:Name="EntriesAddedText" Text="0" FontFamily="Segoe UI" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextAlignment="Center"/><TextBlock Text="补齐登记" FontSize="10" Foreground="{DynamicResource Subtle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                    <StackPanel Grid.Column="2"><TextBlock Text="✓" FontFamily="Segoe UI" FontSize="24" Foreground="{StaticResource Success}" TextAlignment="Center"/><TextBlock Text="打包已校验" FontSize="10" Foreground="{DynamicResource Subtle}" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ReportText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,13,0,0"/>
                            <Border Background="#FFF9EB" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=WarningText}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock x:Name="WarningText" Visibility="Collapsed" FontSize="11.5" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,21,0,0">
                                <Button Content="预览书籍" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Click="PreviewCurrent_Click"/>
                                <Button x:Name="OpenFolderButton" Content="↓  查看修复版" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OpenFolderButton_Click"/>
                                <Button x:Name="SendButton" Content="发送到 Kindle" HorizontalAlignment="Right" MinWidth="158" Click="SendButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="SavedPathText" FontSize="10" Foreground="{DynamicResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="QueueText" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,12,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,23,0,27">
                        <TextBlock Text="①  选入书籍" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="›" FontSize="15" Foreground="#C7C7CC" Margin="22,-2,22,0"/>
                        <TextBlock Text="②  检查修复" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="›" FontSize="15" Foreground="#C7C7CC" Margin="22,-2,22,0"/>
                        <TextBlock Text="③  发送到 Kindle" FontSize="11" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>

                    <Border x:Name="SetupHint" Background="{DynamicResource SoftPanel}" CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="首次使用，先连接你的邮箱" FontSize="11.5" Foreground="{DynamicResource Muted}"/><TextBlock Text="发件地址需要在 Amazon 的认可邮箱列表中。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="去设置  ›" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Click="SettingsButton_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="ReadingDiscoverySection" Margin="0,26,0,24">
                        <Grid Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="为你推荐" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
                                <TextBlock x:Name="RecommendationShelfHint" Text="每次 12 本，向下滑继续发现 · 悬停翻开，看看故事。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="想读清单" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,7" Click="WishList_Click"/>
                                <Button Content="搜索记录" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,7" Click="ReadingHistory_Click"/>
                                <Button Content="换一批  ↻" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="12,7" Margin="6,0,0,0" Click="RefreshRecommendations_Click"/>
                            </StackPanel>
                        </Grid>
                    <Border Style="{StaticResource Card}" Padding="18,20">
                        <StackPanel>
                            <TextBlock x:Name="ReadingTasteText" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="4,0,4,20"/>
                            <ItemsControl x:Name="RecommendationCards" VirtualizingPanel.IsVirtualizing="True">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:VirtualizingBookPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:BookRecommendationCard Book="{Binding Book}" Reason="{Binding Reason}" Margin="5,8,5,28"
                                            SearchRequested="SearchRecommendedBook_Click" DismissRequested="DismissRecommendedBook_Click" WishRequested="WantToRead_Click" Loaded="RecommendationCard_Loaded"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RecommendationEmptyText" Text="暂时没有更多推荐，可在搜索记录中重置“不感兴趣”。" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="5,8"/>
                            <StackPanel x:Name="RecommendationLoading" Visibility="Collapsed" Margin="5,10,5,12">
                                <ProgressBar IsIndeterminate="True" Height="3" Width="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" BorderThickness="0"/>
                                <TextBlock Text="再找 12 本好书…" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="RecommendationLoadFooter" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,6,5,0">
                                <TextBlock x:Name="RecommendationLoadStatus" Text="继续向下滑，发现下一批好书" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                <Button x:Name="RecommendationRetryButton" Content="再试一次  ↻" Style="{StaticResource QuietButton}" FontSize="11" Padding="10,7" Margin="8,0,0,0" Visibility="Collapsed" Click="LoadMoreRecommendations_Click"/>
                            </StackPanel>
                            <Grid Margin="4,18,4,0">
                                <TextBlock x:Name="ReadingDiscoveryNotice" FontSize="10" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,118,0" VerticalAlignment="Center"/>
                                <Button Content="封面：Open Library ↗" Style="{StaticResource QuietButton}" FontSize="9" Padding="0,3" HorizontalAlignment="Right" Click="CoverSource_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="37,0,37,0">
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,7,0"/><TextBlock Text="书籍在本机修复 · Kindle 收件后需联网同步" FontSize="10.5" Foreground="{DynamicResource Muted}"/></StackPanel>
                <Button Content="使用帮助  ?" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Help_Click"/>
            </Grid>
            <Border x:Name="WishFeedbackToast" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,74" MaxWidth="520"
                    Background="#2C4258" CornerRadius="12" Padding="18,11">
                <TextBlock x:Name="WishFeedbackText" FontSize="12" Foreground="#F7FAFC" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
            <Grid x:Name="HelpOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#33000000" KeyboardNavigation.TabNavigation="Cycle" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Style="{StaticResource Card}" Width="420" Padding="29" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="从选书到开读" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,24"/>
                        <TextBlock Text="01   选入 EPUB" FontSize="14" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="选择文件或拖进窗口，可同时加入多本书。" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,21"/>
                        <TextBlock Text="02   检查与修复" FontSize="14" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="补齐图片登记并整理打包。修复版保存在 G 盘，缺少的原图会单独提示。" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,21"/>
                        <TextBlock Text="03   发往 Kindle" FontSize="14" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="在设置中连接一次发件邮箱，以后可以自动发送。邮件已提交后，等待 Amazon 处理并让 Kindle 联网同步。" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                        <Border Background="{DynamicResource SoftPanel}" CornerRadius="11" Padding="13"><TextBlock Text="Z-Library 下载的 EPUB 会自动进入同一流程。网站会话过期时，在书库重新登录即可。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
                        <Button x:Name="HelpCloseButton" Content="知道了" Margin="0,23,0,0" Click="HelpClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
