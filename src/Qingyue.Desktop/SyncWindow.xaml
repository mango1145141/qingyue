<Window x:Class="EpubKindleFix.SyncWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="轻阅 · 设备同步" Icon="Assets/KindleIcon.png" Width="580" Height="790" MinWidth="500" MinHeight="580"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource Canvas}" FontFamily="Microsoft YaHei UI, Segoe UI" ShowInTaskbar="False">
 <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="2,0,2,20"><TextBlock Text="轻 阅  /  设 备 同 步" FontSize="10" Foreground="{DynamicResource Subtle}" Margin="0,0,0,12"/><TextBlock Text="手机和电脑，记住同一份。" FontSize="24" FontWeight="Medium"/><TextBlock Text="配对一次，以后打开即可自动同步邮箱和偏好。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="22,20"><StackPanel>
    <TextBlock Text="用 iPhone 相机扫描二维码" FontSize="15" FontWeight="Medium"/>
    <TextBlock Text="扫描后在 Safari 打开，手机会自动完成配对。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,16" TextWrapping="Wrap"/>
    <Button x:Name="GenerateButton" Content="生成手机配对二维码" Click="Generate_Click"/>
    <Image x:Name="QrImage" Width="230" Height="230" Margin="0,16,0,0" Visibility="Collapsed" Stretch="Uniform"/>
    <TextBlock x:Name="ExpiryText" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Button x:Name="CopyButton" Content="复制配对链接" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="0,8,0,0" Click="Copy_Click"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0"><StackPanel>
    <TextBlock Text="或粘贴手机生成的配对链接" FontSize="12" Margin="0,0,0,9"/>
    <TextBox x:Name="PairInput" AutomationProperties.Name="配对链接"/>
    <Button x:Name="ConnectButton" Content="连接设备" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Click="Connect_Click"/>
   </StackPanel></Border>
   <TextBlock Text="同步内容：发件邮箱、Kindle 接收邮箱、自动修复、电脑自动发送和手机记录偏好。书籍、邮箱授权及书库登录保留在各自设备上。配对链接 5 分钟内有效，请仅交给自己的设备。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="3,15,3,8"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="SyncStatus" Text="尚未配对" FontSize="12" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <Grid><StackPanel Orientation="Horizontal"><Button x:Name="RefreshButton" Content="立即同步" Style="{StaticResource QuietButton}" Click="Refresh_Click"/><Button x:Name="DisconnectButton" Content="断开此设备" Style="{StaticResource QuietButton}" Click="Disconnect_Click" Margin="8,0,0,0"/></StackPanel><Button x:Name="DoneButton" Content="完成" HorizontalAlignment="Right" MinWidth="92" Click="Done_Click"/></Grid>
  </StackPanel>
 </Grid>
</Window>
