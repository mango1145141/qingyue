<Window x:Class="EpubKindleFix.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻阅 · 设置" Icon="Assets/KindleIcon.png" Width="620" Height="700" MinWidth="530" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource Canvas}"
        FontFamily="Microsoft YaHei UI, Segoe UI" ShowInTaskbar="False">
    <Grid Margin="30,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,3,23">
            <TextBlock Text="轻 阅  /  设 置" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
            <TextBlock Text="让好书，直接抵达。" FontSize="27" FontWeight="Medium" Foreground="{DynamicResource Ink}"/>
            <TextBlock Text="两处邮箱，一次连接。其他交给轻阅。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,3">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="23,21">
                    <StackPanel>
                        <TextBlock Text="发件邮箱" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <TextBox x:Name="SenderEmailBox" TextChanged="SenderEmail_Changed" AutomationProperties.Name="发件邮箱"/>
                        <TextBlock x:Name="ProviderNotice" Text="填写已被 Amazon 认可的邮箱地址。" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                        <TextBlock Text="Kindle 接收邮箱" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <TextBox x:Name="KindleEmailBox" AutomationProperties.Name="Kindle 接收邮箱"/>
                        <TextBlock Text="Kindle 的专属接收地址，可在 Amazon 个人文档设置中找到。" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22,19" Margin="0,13,0,0">
                    <StackPanel>
                        <TextBlock Text="发件连接" FontSize="10" Foreground="{DynamicResource Subtle}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="SenderConnectionText" Text="首次使用，连接一次发件邮箱。" FontSize="13" Foreground="{DynamicResource Ink}" FontWeight="Medium" TextWrapping="Wrap"/>
                        <TextBlock Text="优先使用电脑上已登录的经典版 Outlook。其他支持的邮箱按引导授权一次，以后自动发送。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,14"/>
                        <Button x:Name="ConnectSenderButton" Content="连接发件邮箱" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="16,10" Click="ConnectSender_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0">
                    <CheckBox x:Name="AutoSendCheck" Style="{StaticResource Switch}" IsChecked="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="拖入书籍后自动修复并发送">
                        <StackPanel><TextBlock Text="修复后自动发送" FontSize="12"/><TextBlock Text="关闭后，先查看结果，再手动发送。" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0"><StackPanel>
                    <CheckBox x:Name="AutoRepairCheck" Style="{StaticResource Switch}" IsChecked="True" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="选入后自动修复" FontSize="12"/><TextBlock Text="关闭后，选入书籍再点检查并修复。" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></CheckBox>
                    <CheckBox x:Name="RememberHistoryCheck" Style="{StaticResource Switch}" IsChecked="True" HorizontalContentAlignment="Stretch" Margin="0,20,0,0"><StackPanel><TextBlock Text="手机端保存最近修复记录" FontSize="12"/><TextBlock Text="配对后同步此偏好，记录留在手机浏览器。" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></CheckBox>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0"><StackPanel>
                    <CheckBox x:Name="PreviewBeforeSendCheck" Style="{StaticResource Switch}" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="发送前预览确认" FontSize="12"/><TextBlock Text="每本书修复后，查看封面、目录与正文，再确认发送。" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></CheckBox>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0"><StackPanel>
                    <TextBlock Text="推荐偏好" FontSize="14" FontWeight="Medium" Margin="0,0,0,12"/>
                    <TextBlock Text="熟悉的题材，还是新的阅读口味？" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="DiscoveryModeBox" Margin="0,0,0,16"/>
                    <CheckBox x:Name="ChinesePriorityCheck" Style="{StaticResource Switch}" Content="中文书籍优先"/>
                    <TextBlock Text="喜欢的题材" FontSize="11" Margin="0,20,0,8"/>
                    <WrapPanel x:Name="FavoriteGenresPanel"/>
                    <TextBlock Text="不想看到的题材" FontSize="11" Margin="0,16,0,8"/>
                    <WrapPanel x:Name="ExcludedGenresPanel"/>
                    <TextBlock Text="收藏到想读清单的书，也会帮助推荐了解你的口味。" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,13,0,0"><StackPanel>
                    <TextBlock Text="外观与动效" FontSize="14" FontWeight="Medium" Margin="0,0,0,12"/>
                    <TextBlock Text="外观" FontSize="11" Margin="0,0,0,8"/><ComboBox x:Name="ThemeBox" Margin="0,0,0,16"/>
                    <TextBlock Text="文字大小" FontSize="11" Margin="0,0,0,8"/><ComboBox x:Name="TextScaleBox" Margin="0,0,0,16"/>
                    <TextBlock Text="动效手感" FontSize="11" Margin="0,0,0,8"/><ComboBox x:Name="MotionBox"/>
                    <TextBlock Text="默认保持现有 Q 弹动效；减少动效会关闭翻书与按钮动画。" FontSize="10.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,17,0,0">
            <Border x:Name="ErrorPanel" Background="#FFECEA" CornerRadius="10" Margin="0,0,0,12" Padding="13,11">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=SettingsError}" Value="Collapsed"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock x:Name="SettingsError" Visibility="Collapsed" FontSize="11.5" Foreground="#D70015" TextWrapping="Wrap"/>
            </Border>
            <Grid>
                <TextBlock Text="连接凭据在本机加密保存" FontSize="10" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource QuietButton}" Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button x:Name="SaveSettingsButton" Content="保存设置" IsDefault="True" MinWidth="116" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
