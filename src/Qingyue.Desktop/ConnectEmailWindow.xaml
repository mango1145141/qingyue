<Window x:Class="EpubKindleFix.ConnectEmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻阅 · 连接发件邮箱" Icon="Assets/KindleIcon.png" Width="580" Height="680" MinWidth="510" MinHeight="550"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Canvas}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="30,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,3,22">
            <TextBlock Text="轻 阅  /  发 件 连 接" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
            <TextBlock Text="连接一次，以后自动发送。" FontSize="25" FontWeight="Medium"/>
            <TextBlock x:Name="EmailLabel" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,3">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="23,22">
                    <StackPanel>
                        <TextBlock x:Name="ProviderLabel" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InstructionsText" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenProviderButton" Content="打开官方页面  ↗" Style="{StaticResource SecondaryButton}" Click="OpenProvider_Click" Padding="14,10"/>
                            <Button x:Name="OpenHelpButton" Content="查看获取方法" Style="{StaticResource QuietButton}" Click="OpenHelp_Click" Padding="12,10" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="CodePanel" Margin="1,25,1,0">
                    <TextBlock Text="粘贴邮箱提供的授权码" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <PasswordBox x:Name="AuthorizationCodeBox" AutomationProperties.Name="邮箱授权码"/>
                    <TextBlock Text="使用邮箱生成的专用授权码。轻阅会在这台电脑上加密保存，以后无需重复填写。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Background="{DynamicResource SoftPanel}" CornerRadius="12" Padding="15" Margin="0,23,0,0">
                    <TextBlock Text="电脑上已登录的经典版 Outlook 也可以直接使用，轻阅会匹配你填写的发件地址。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" LineHeight="19"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,17,0,0">
            <TextBlock x:Name="ConnectionStatus" FontSize="11.5" TextWrapping="Wrap" Foreground="#D70015" Margin="0,0,0,12"/>
            <ProgressBar x:Name="ConnectingProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="稍后连接" Style="{StaticResource QuietButton}" Click="Later_Click" Margin="0,0,12,0"/>
                <Button x:Name="ConnectButton" Content="验证并连接" MinWidth="128" Click="Connect_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
