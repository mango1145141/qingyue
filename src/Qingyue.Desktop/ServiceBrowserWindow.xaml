<Window x:Class="EpubKindleFix.ServiceBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:EpubKindleFix"
        Title="轻阅" Icon="Assets/KindleIcon.png" Width="1120" Height="820" MinWidth="860" MinHeight="620"
        FontFamily="Microsoft YaHei UI, Segoe UI" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterOwner">
    <Grid Margin="25,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="让阅读，继续抵达。" FontSize="23" FontWeight="Medium"/>
                <TextBlock x:Name="Subtitle" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="←" ToolTip="返回上一页" Style="{StaticResource SecondaryButton}" Click="Back_Click" Padding="15,10" Margin="0,0,8,0"/>
                <Button Content="首页" Style="{StaticResource QuietButton}" Click="Home_Click" Margin="0,0,7,0"/>
                <Button x:Name="ExternalButton" Content="使用 Edge 继续 ↗" Style="{StaticResource SecondaryButton}" Click="External_Click" Margin="0,0,8,0"/>
                <Button Content="返回轻阅 ›" MinWidth="125" Click="Return_Click"/>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource SoftPanel}" CornerRadius="9" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="AddressLabel" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Border x:Name="UploadCard" Grid.Row="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock x:Name="FileLabel" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UploadNotice" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <ProgressBar x:Name="UploadProgress" Height="4" Margin="0,11,0,0" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="ContinueButton" Content="继续自动上传" Style="{StaticResource SecondaryButton}" Click="Continue_Click" Margin="0,0,8,0"/>
                    <Button x:Name="LaterButton" Content="稍后发送" Style="{StaticResource QuietButton}" Click="Later_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Border Style="{StaticResource Card}" CornerRadius="14"/>
            <wv:WebView2 x:Name="Browser" Margin="1"/>
            <local:AmazonBrowserHost x:Name="AmazonBrowser" Margin="1" Visibility="Collapsed"/>
            <Border x:Name="ErrorCard" Visibility="Collapsed" Style="{StaticResource Card}" Width="580" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" FontSize="15" TextWrapping="Wrap" LineHeight="25"/>
                    <Button Content="重新打开网页" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Reload_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="WebForAllCheck" Content="小文件也使用亚马逊网页发送" Visibility="Collapsed" Style="{StaticResource Switch}" FontSize="11" HorizontalAlignment="Left" Margin="0,0,0,9" Click="WebForAll_Click"/>
            <TextBlock x:Name="BrowserStatus" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
