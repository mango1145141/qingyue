<Window x:Class="EpubKindleFix.ReadingHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="轻阅 · 搜索记录" Icon="Assets/KindleIcon.png" Width="580" Height="690" MinHeight="480"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" ResizeMode="CanResizeWithGrip">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="了解你的阅读口味" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="搜索记录加密保存在这台电脑，用于推荐相关题材。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,20"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <CheckBox x:Name="RememberSearchesCheck" Style="{StaticResource Switch}" Click="RememberSearches_Click"><StackPanel><TextBlock Text="根据搜索记录推荐" FontSize="12"/><TextBlock Text="关闭后暂停记录，显示不同类型的精选书。" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></CheckBox>
                <TextBlock Text="从新版开始记录；最近 180 天的搜索参与推荐。" FontSize="10" Foreground="{DynamicResource Subtle}" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SearchHistoryList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="3,13">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Query}" TextWrapping="Wrap" FontSize="12" Margin="0,0,18,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHistoryText" Text="还没有搜索记录，搜一本喜欢的书试试。" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="HistoryNotice" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
            <Grid>
                <Button Content="清空记录并重置推荐" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" FontSize="11" Click="ClearHistory_Click"/>
                <Button Content="完成" HorizontalAlignment="Right" MinWidth="100" IsCancel="True" Click="Done_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
