<Window x:Class="EpubKindleFix.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="轻阅 · Z-Library 书库" Icon="Assets/KindleIcon.png" Width="1120" Height="820" MinWidth="860" MinHeight="620"
    FontFamily="Microsoft YaHei UI, Segoe UI" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterOwner">
    <Grid Margin="25,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="找一本想读的书。" FontSize="23" FontWeight="Medium"/><TextBlock Text="Z-LIBRARY  /  登录 · 选书 · 下载" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="←" ToolTip="返回上一页" Style="{StaticResource SecondaryButton}" Click="Back_Click" Padding="15,10" Margin="0,0,8,0"/>
                <Button Content="更换网址" Style="{StaticResource QuietButton}" Click="ChangeWebsite_Click" Margin="0,0,10,0"/>
                <Button x:Name="FinishLoginButton" Content="确认登录" Style="{StaticResource QuietButton}" Click="FinishLogin_Click" IsEnabled="False" Margin="0,0,10,0"/>
                <Button Content="返回轻阅  ›" MinWidth="125" ToolTip="返回轻阅主页，保留当前书库页面" Click="Return_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource SoftPanel}" CornerRadius="9" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="AddressLabel" Text="尚未连接网站" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" CornerRadius="14"/>
            <wv:WebView2 x:Name="Browser" Visibility="Collapsed" Margin="1"/>
            <Grid x:Name="SetupCard" Width="570" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Style="{StaticResource CardShadowLayer}"/>
            <Border Style="{StaticResource Card}" Padding="36">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,19">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="连接你的 Z-Library 入口" FontSize="25" FontWeight="Medium"/>
                    <TextBlock Text="在网站里登录和选书，下载后交给轻阅。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,26"/>
                    <TextBlock Text="网站地址" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox x:Name="WebsiteBox" KeyDown="WebsiteBox_KeyDown" AutomationProperties.Name="书库网址"/>
                    <TextBlock x:Name="SetupError" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11.5" Margin="0,11,0,0"/>
                    <Button x:Name="OpenWebsiteButton" Content="打开登录页  ↗" HorizontalAlignment="Left" MinWidth="147" Margin="0,22,0,0" Click="OpenWebsite_Click"/>
                    <Button x:Name="RuntimeButton" Content="安装微软网页组件" Visibility="Collapsed" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,11,0,0" Click="Runtime_Click"/>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,27,0,0" Padding="0,15,0,0">
                        <TextBlock Text="账号和密码直接在网站填写。轻阅保留本机网页会话，不单独保存网站密码。" Foreground="{DynamicResource Subtle}" FontSize="10.5" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
            </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="BrowserStatus" Text="选择 EPUB，下载完成后会自动检查、修复，并按你的设置发送。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Height="3" Margin="0,9,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
