<UserControl x:Class="EpubKindleFix.BookRecommendationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True" HorizontalContentAlignment="Stretch" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" IsKeyboardFocusWithinChanged="FocusWithin_Changed"
             PreviewKeyDown="Card_KeyDown" PreviewMouseDown="Card_PreviewMouseDown" AutomationProperties.HelpText="悬停或按 Tab 查看作者与简介，按回车搜索">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WantedButtonFill" Color="#2C4258"/>
        <SolidColorBrush x:Key="WantedButtonText" Color="#F7FAFC"/>
        <MaterialGroup x:Key="LeafMaterial">
            <DiffuseMaterial><DiffuseMaterial.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#DACDB8" Offset="0"/><GradientStop Color="#FBF6EB" Offset="0.16"/>
                <GradientStop Color="#FFFDF6" Offset="0.65"/><GradientStop Color="#E9DECA" Offset="1"/>
            </LinearGradientBrush></DiffuseMaterial.Brush></DiffuseMaterial>
            <SpecularMaterial Brush="#14FFFFFF" SpecularPower="18"/>
        </MaterialGroup>
        <DiffuseMaterial x:Key="EdgeMaterial" Brush="#D6C6AD"/>
    </UserControl.Resources>
    <StackPanel>
        <Grid x:Name="HoverSurface" Width="160" Height="240" HorizontalAlignment="Center" Background="Transparent"
              MouseEnter="Cover_MouseEnter" MouseLeave="Cover_MouseLeave">
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="BookScale"/><TranslateTransform x:Name="BookLift"/></TransformGroup></Grid.RenderTransform>
            <Border Background="White" CornerRadius="7" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect x:Name="BookShadow" BlurRadius="13" ShadowDepth="4" Opacity="0.13" Color="#384A60"/></Border.Effect>
            </Border>
            <Border Background="#CDD5DC" CornerRadius="6" Margin="3,4,-3,-4" IsHitTestVisible="False"/>
            <Border Background="#E7E1D7" CornerRadius="6" Margin="1,2,-1,-2" IsHitTestVisible="False"/>
            <Border Width="3" HorizontalAlignment="Right" Margin="0,5,-2,1" Background="#F7F3EA" IsHitTestVisible="False"/>
            <Border Height="1" VerticalAlignment="Bottom" Margin="5,0,1,-2" Background="#C7BEAC" IsHitTestVisible="False"/>
            <Grid x:Name="CoverArea" Background="Transparent">
                <Border Background="#F8F5EE" BorderBrush="#E3E3E8" BorderThickness="1" CornerRadius="8">
                    <Grid x:Name="Introduction" Margin="16,15,14,12" Opacity="0" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="None">
                        <Grid.RenderTransform><TranslateTransform x:Name="IntroOffset" X="10"/></Grid.RenderTransform>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="InsideTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextWrapping="Wrap" MaxHeight="39" LineHeight="19"/>
                        <TextBlock x:Name="InsideAuthor" Grid.Row="1" FontSize="10.5" Foreground="#86868B" TextWrapping="Wrap" Margin="0,6,0,8" MaxHeight="30"/>
                        <TextBlock x:Name="InsideDescription" Grid.Row="2" FontSize="11" Foreground="#48484A" TextWrapping="Wrap" LineHeight="18" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button x:Name="SearchButton" Content="去书库搜索  ↗" FontSize="10.5" Padding="6,7" Click="Search_Click"/>
                            <Button x:Name="WishButton" Content="＋ 想读" Style="{StaticResource QuietButton}" FontSize="9.5" Padding="3,5" Click="Wish_Click"/>
                            <Button x:Name="DismissButton" Content="不感兴趣" Style="{StaticResource QuietButton}" FontSize="9.5" Padding="3,5" Margin="0,3,0,0" Click="Dismiss_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="FoldShadow" Width="40" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False" CornerRadius="6">
                    <Border.RenderTransform><TranslateTransform x:Name="FoldShadowShift"/></Border.RenderTransform>
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#663E3022" Offset="0"/><GradientStop Color="#003E3022" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Border Width="10" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#553F3021" Offset="0"/><GradientStop Color="#00A79170" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Viewport3D x:Name="PageViewport" Width="368" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-192,-40,0,0" IsHitTestVisible="False" ClipToBounds="True">
                    <Viewport3D.Camera>
                        <PerspectiveCamera Position="-8,120,850" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="24.4295"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D><ModelVisual3D.Content><Model3DGroup><AmbientLight Color="#E6E6E6"/><DirectionalLight Color="#292929" Direction="-0.6,-0.3,-1"/></Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D><ModelVisual3D.Content><GeometryModel3D x:Name="SecondLeaf" Material="{StaticResource LeafMaterial}" BackMaterial="{StaticResource LeafMaterial}"/></ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D><ModelVisual3D.Content><GeometryModel3D x:Name="FirstLeaf" Material="{StaticResource LeafMaterial}" BackMaterial="{StaticResource LeafMaterial}"/></ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D><ModelVisual3D.Content>
                        <GeometryModel3D x:Name="PageBack">
                            <GeometryModel3D.BackMaterial><MaterialGroup>
                                <DiffuseMaterial><DiffuseMaterial.Brush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#BFAE92" Offset="0"/><GradientStop Color="#EEE4D2" Offset="0.15"/><GradientStop Color="#F7F0E3" Offset="0.75"/><GradientStop Color="#D5C6AD" Offset="1"/></LinearGradientBrush>
                                </DiffuseMaterial.Brush></DiffuseMaterial>
                                <SpecularMaterial Brush="#10FFFFFF" SpecularPower="16"/>
                            </MaterialGroup></GeometryModel3D.BackMaterial>
                        </GeometryModel3D>
                    </ModelVisual3D.Content></ModelVisual3D>
                    <ModelVisual3D><ModelVisual3D.Content><GeometryModel3D x:Name="CoverEdge" Material="{StaticResource EdgeMaterial}" BackMaterial="{StaticResource EdgeMaterial}"/></ModelVisual3D.Content></ModelVisual3D>
                    <Viewport2DVisual3D x:Name="PageSurface">
                        <Viewport2DVisual3D.Material><DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True"/></Viewport2DVisual3D.Material>
                        <Viewport2DVisual3D.Visual>
                            <Grid Width="160" Height="240" Background="#1D1D1F">
                                <Grid.Clip><RectangleGeometry Rect="0,0,160,240" RadiusX="5" RadiusY="5"/></Grid.Clip>
                                <Grid x:Name="FallbackCover">
                                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Margin="12"/>
                                    <StackPanel Margin="22,27,17,21">
                                        <TextBlock Text="轻 阅 · 书 架" FontSize="9" Foreground="#8E8E93" Margin="0,0,0,21"/>
                                        <TextBlock x:Name="FallbackTitle" FontSize="21" FontWeight="Medium" Foreground="White" TextWrapping="Wrap" LineHeight="29"/>
                                        <TextBlock x:Name="FallbackAuthor" FontSize="10" Foreground="#D1D1D6" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CoverStatus" Text="封面加载中" FontSize="9" Foreground="#8E8E93" Margin="20,0,12,20" VerticalAlignment="Bottom"/>
                                </Grid>
                                <Image x:Name="CoverImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                <Border Width="9" HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#33000000" Offset="0"/><GradientStop Color="#06000000" Offset="1"/></LinearGradientBrush></Border.Background>
                                </Border>
                            </Grid>
                        </Viewport2DVisual3D.Visual>
                    </Viewport2DVisual3D>
                </Viewport3D>
                <Border x:Name="FocusOutline" BorderBrush="#A5BDD5" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        </Grid>
        <TextBlock x:Name="OutsideTitle" Width="160" HorizontalAlignment="Center" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" MaxHeight="36" Margin="0,12,0,0"/>
        <TextBlock x:Name="OutsideGenre" Width="160" HorizontalAlignment="Center" FontSize="9.5" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,5,0,0"/>
    </StackPanel>
</UserControl>
